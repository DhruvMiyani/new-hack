# Copy to .env and fill in. Everything here is optional: the measurement runs
# from executed code, so `python verify.py run --offline` needs no keys at all.

# ---- Meta Model API (dev.meta.ai) ---------------------------------------
# Writes implementations and test suites. OpenAI-compatible chat completions.
# MODEL_API_KEY is the name Meta's own quickstart uses; either works.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# ---- Subquadratic (console.subq.ai) -------------------------------------
# SubQ Snap 1.1 Decisions API. Adjudicates test independence and defect
# severity. 384K context; you pay for input only, output tokens are free.
SUBQ_API_KEY=
SUBQ_MODEL=subq-snap-1.1
SUBQ_BASE_URL=https://api.subq.ai/v1

# ---- Fetch.ai / ASI:One agent -------------------------------------------
# The seed derives the agent's address: keep it secret and stable.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini
AGENT_NAME=codegate-verifier
AGENT_SEED=replace-with-a-unique-random-phrase
AGENT_PORT=8001

# ---- Execution policy (pre-hackathon CodeGate engine) -------------------
# off | local | prover. Defaults to off: nothing is executed by the agent.
CODEGATE_EXEC_POLICY=off
CODEGATE_ACK_PUBLIC_EXEC=false

PROVER_NAME=codegate-prover
PROVER_SEED=replace-with-a-different-random-phrase
PROVER_PORT=8002
PROVER_MAILBOX=false
PROVER_ADDRESS=
PROVER_ENDPOINT=

# ---- Optional ------------------------------------------------------------
# Raises the GitHub API rate limit when reviewing PRs.
GITHUB_TOKEN=
