# ---- ASI:One -------------------------------------------------------------
# https://asi1.ai/developer  ->  Dashboard -> API Keys
# Optional: without it the agent still works, using deterministic fallbacks
# for intent routing and skipping the plain-English summary.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# ---- Gate agent (the one ASI:One talks to) -------------------------------
AGENT_NAME=codegate-verifier
AGENT_SEED=replace-with-a-unique-random-phrase
AGENT_PORT=8001

# ---- Execution policy ----------------------------------------------------
# off    static analysis only; nothing is executed, nothing can block (default)
# local  run probes in this process's sandbox -- only on a machine you can throw away
# prover run probes ONLY on the prover agent below; no local fallback
CODEGATE_EXEC_POLICY=off
# Set true to acknowledge that 'local' executes code sent by anyone who can reach the agent.
CODEGATE_ACK_PUBLIC_EXEC=false

# ---- Prover agent (isolated probe executor) ------------------------------
PROVER_NAME=codegate-prover
PROVER_SEED=replace-with-a-different-random-phrase
PROVER_PORT=8002
PROVER_MAILBOX=false
# Printed by prover_agent.py on startup; paste it here for CODEGATE_EXEC_POLICY=prover
PROVER_ADDRESS=

# ---- Optional ------------------------------------------------------------
# Raises the GitHub API rate limit when reviewing PRs.
GITHUB_TOKEN=
PROVER_ENDPOINT=
